#!/bin/bash

set -euo pipefail
set +x
umask 077

gpg_bin=$(command -v gpg || true)
git_bin=$(command -v git || true)
identities_file="${XDG_CONFIG_HOME:-"$HOME/.config"}/git/signing-identities.sh"
signing=0

if [[ -z "$gpg_bin" || ! -x "$gpg_bin" ]]; then
  printf '%s\n' 'gpg-git-sign: cannot find an executable gpg in PATH.' >&2
  printf '%s\n' '  Fix: install modern GnuPG, then confirm `command -v gpg` prints its absolute path.' >&2
  exit 2
fi
if [[ -z "$git_bin" || ! -x "$git_bin" ]]; then
  printf '%s\n' 'gpg-git-sign: cannot find an executable git in PATH.' >&2
  printf '%s\n' '  Fix: install Git, then confirm `command -v git` prints its absolute path.' >&2
  exit 2
fi

for argument in "$@"; do
  case "$argument" in
    --sign | --detach-sign | --clearsign)
      signing=1
      ;;
    --*)
      ;;
    -?*)
      short_options=${argument#-}
      if [[ "$short_options" == *s* || "$short_options" == *b* ]]; then
        signing=1
      fi
      ;;
  esac
done

unset GNUPGHOME

if [[ "$signing" -eq 0 ]]; then
  exec "$gpg_bin" "$@"
fi

if [[ ! -r "$identities_file" ]]; then
  printf 'gpg-git-sign: identity configuration is missing or unreadable: %s\n' \
    "$identities_file" >&2
  printf '%s\n' \
    '  Fix: run the dotfiles installer or create this file from config/git/signing-identities.sh.' >&2
  exit 2
fi

GPG_GIT_IDENTITIES_PATH=$identities_file
. "$identities_file"
gpg_git_load_identities

email=$("$git_bin" config --get user.email 2>/dev/null || true)
email="${email#"${email%%[![:space:]]*}"}"
email="${email%"${email##*[![:space:]]}"}"
email_lower=$(LC_ALL=C printf '%s' "$email" | tr '[:upper:]' '[:lower:]')

if [[ -z "$email_lower" ]]; then
  printf '%s\n' 'gpg-git-sign: refusing to sign because user.email is missing' >&2
  printf '%s\n' \
    '  Fix: set a configured repository identity with `git config user.email you@example.com`.' >&2
  exit 2
fi
if ! gpg_git_find_identity "$email_lower"; then
  printf 'gpg-git-sign: refusing to sign for unsupported user.email: %s\n' "$email" >&2
  printf '  Fix: add this email and its signing subkey to %s, or set one of these configured emails:\n' \
    "$identities_file" >&2
  gpg_git_list_configured_emails >&2
  exit 2
fi
signing_fingerprint="$gpg_git_identity_fingerprint!"

secret_listing=$(
  "$gpg_bin" \
    --batch \
    --with-colons \
    --with-fingerprint \
    --with-subkey-fingerprint \
    --list-secret-keys "$gpg_git_identity_fingerprint" 2>/dev/null || true
)
if ! printf '%s\n' "$secret_listing" | awk -F: -v fingerprint="$gpg_git_identity_fingerprint" '
  $1=="ssb" {
    usable=($15=="+")
    next
  }
  $1=="fpr" && $10==fingerprint && usable {
    found=1
  }
  END {
    exit !found
  }
'; then
  printf 'gpg-git-sign: configured signing subkey is unavailable for %s: %s\n' \
    "$email_lower" "$gpg_git_identity_fingerprint" >&2
  printf '%s\n' \
    '  Fix: import the secret signing subkey into the standard GnuPG home, then verify it with:' >&2
  printf '  gpg --list-secret-keys %s\n' "$gpg_git_identity_fingerprint" >&2
  exit 2
fi

rewritten_arguments=()
skip_next=0

for argument in "$@"; do
  if [[ "$skip_next" -eq 1 ]]; then
    skip_next=0
    continue
  fi

  case "$argument" in
    --local-user | --default-key)
      skip_next=1
      ;;
    --local-user=* | --default-key=*)
      ;;
    --*)
      rewritten_arguments+=("$argument")
      ;;
    -?*)
      short_options=${argument#-}
      if [[ "$short_options" == *u* ]]; then
        options_before_user=${short_options%%u*}
        options_after_user=${short_options#*u}
        if [[ -n "$options_before_user" ]]; then
          rewritten_arguments+=("-$options_before_user")
        fi
        if [[ -z "$options_after_user" ]]; then
          skip_next=1
        fi
      else
        rewritten_arguments+=("$argument")
      fi
      ;;
    *)
      rewritten_arguments+=("$argument")
      ;;
  esac
done

exec "$gpg_bin" --local-user "$signing_fingerprint" "${rewritten_arguments[@]}"

#!/bin/bash

set -euo pipefail
set +x
umask 077

git_bin=$(command -v git || true)
remote_name=${1:-}
remote_url=${2:-}
identities_file="${XDG_CONFIG_HOME:-"$HOME/.config"}/git/signing-identities.sh"

if [[ -z "$git_bin" || ! -x "$git_bin" ]]; then
  printf '%s\n' 'pre-push: cannot find an executable git in PATH.' >&2
  printf '%s\n' '  Fix: install Git, then confirm `command -v git` prints its absolute path.' >&2
  exit 2
fi

if [[ -z "$remote_name" || -z "$remote_url" ]]; then
  printf '%s\n' 'pre-push: Git did not provide both the remote name and URL.' >&2
  printf '%s\n' \
    '  Fix: invoke this as a Git pre-push hook, or provide `<remote-name> <remote-url>` when testing manually.' >&2
  exit 2
fi

if [[ ! -r "$identities_file" ]]; then
  printf 'pre-push: identity configuration is missing or unreadable: %s\n' \
    "$identities_file" >&2
  printf '%s\n' \
    '  Fix: run the dotfiles installer or create this file from config/git/signing-identities.sh.' >&2
  exit 2
fi

GPG_GIT_IDENTITIES_PATH=$identities_file
. "$identities_file"
gpg_git_load_identities
primary_fingerprint=$GPG_GIT_PRIMARY_FINGERPRINT

temporary_root=${TMPDIR:-/tmp}
temporary_root=${temporary_root%/}
if [[ ! -d "$temporary_root" || ! -w "$temporary_root" ]]; then
  printf 'pre-push: temporary directory is unavailable or unwritable: %s\n' \
    "$temporary_root" >&2
  printf '%s\n' '  Fix: set TMPDIR to a private writable directory.' >&2
  exit 2
fi

temporary_dir=$(mktemp -d "$temporary_root/gpg-pre-push.XXXXXX")
case "$temporary_dir" in
  "$temporary_root"/gpg-pre-push.*) ;;
  *)
    printf 'pre-push: mktemp returned an unexpected path: %s\n' "$temporary_dir" >&2
    printf '  Expected a directory under: %s\n' "$temporary_root" >&2
    exit 2
    ;;
esac

cleanup() {
  rm -rf "$temporary_dir"
}
trap cleanup EXIT

push_input="$temporary_dir/push-input"
commits_file="$temporary_dir/commits"
unique_commits_file="$temporary_dir/commits-unique"

/bin/cat > "$push_input"
: > "$commits_file"

trim_email() {
  local value=$1
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  LC_ALL=C printf '%s' "$value" | tr '[:upper:]' '[:lower:]'
}

while IFS=' ' read -r local_ref local_oid remote_ref remote_oid extra; do
  [[ -z "${extra:-}" ]] || {
    printf 'pre-push: malformed ref update from Git: %s %s %s %s %s\n' \
      "$local_ref" "$local_oid" "$remote_ref" "$remote_oid" "$extra" >&2
    printf '%s\n' \
      '  Fix: rerun the push normally. If this repeats, inspect any wrapper that writes pre-push standard input.' >&2
    exit 2
  }
  [[ -n "${local_ref:-}" && -n "${local_oid:-}" && -n "${remote_ref:-}" && -n "${remote_oid:-}" ]] || continue
  [[ "$local_oid" =~ ^0+$ ]] && continue

  local_commit=$("$git_bin" rev-parse --verify "$local_oid^{commit}" 2>/dev/null) || continue

  if [[ "$remote_oid" =~ ^0+$ ]]; then
    "$git_bin" rev-list "$local_commit" --not --remotes="$remote_name" >> "$commits_file"
  else
    "$git_bin" rev-list "$local_commit" --not "$remote_oid" >> "$commits_file"
  fi
done < "$push_input"

LC_ALL=C sort -u "$commits_file" > "$unique_commits_file"

while IFS= read -r commit_oid; do
  [[ -n "$commit_oid" ]] || continue

  exec 3< <("$git_bin" show --no-ext-diff --no-textconv -s \
    --format='%ce%x00%G?%x00%GF%x00%GP%x00' "$commit_oid")
  IFS= read -r -d '' commit_email <&3 || {
    printf 'pre-push: cannot read committer email for %s\n' "$commit_oid" >&2
    printf '%s\n' \
      '  Fix: verify that the object is a readable commit with `git cat-file -t <commit>`.' >&2
    exit 1
  }
  IFS= read -r -d '' signature_status <&3 || true
  IFS= read -r -d '' signing_fingerprint <&3 || true
  IFS= read -r -d '' signing_primary <&3 || true
  exec 3<&-

  commit_email=$(trim_email "$commit_email")

  if ! gpg_git_find_identity "$commit_email"; then
    continue
  fi
  expected_fingerprint=$gpg_git_identity_fingerprint

  case "$signature_status" in
    G | U) ;;
    *)
      printf 'pre-push: commit %s does not have a valid known OpenPGP signature\n' "$commit_oid" >&2
      printf '  Commit identity: %s; signature status: %s\n' \
        "$commit_email" "${signature_status:-<missing>}" >&2
      printf '%s\n' \
        '  Fix: configure the intended email and signing subkey, then amend and sign the commit before pushing.' >&2
      exit 1
      ;;
  esac

  if [[ "$signing_fingerprint" != "$expected_fingerprint" ]]; then
    printf 'pre-push: commit %s used signing subkey %s instead of %s\n' \
      "$commit_oid" "${signing_fingerprint:-<none>}" "$expected_fingerprint" >&2
    printf '  Commit identity: %s\n' "$commit_email" >&2
    printf '%s\n' \
      '  Fix: set the repository email to the intended configured identity, then amend and re-sign the commit.' >&2
    exit 1
  fi

  if [[ "$signing_primary" != "$primary_fingerprint" ]]; then
    printf 'pre-push: commit %s has unexpected primary fingerprint %s\n' \
      "$commit_oid" "${signing_primary:-<none>}" >&2
    printf '  Expected primary fingerprint: %s\n' "$primary_fingerprint" >&2
    printf '%s\n' \
      '  Fix: verify the configured subkey belongs to the expected OpenPGP hierarchy, then amend and re-sign the commit.' >&2
    exit 1
  fi
done < "$unique_commits_file"

git_dir=$("$git_bin" rev-parse --absolute-git-dir)
repository_hook="$git_dir/hooks/pre-push"
if [[ -x "$repository_hook" && ! "$repository_hook" -ef "$0" ]]; then
  "$repository_hook" "$@" < "$push_input"
fi

local_hook="${0}.local"
if [[ -x "$local_hook" && ! "$local_hook" -ef "$0" ]]; then
  "$local_hook" "$@" < "$push_input"
fi
